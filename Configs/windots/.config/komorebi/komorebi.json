{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.38/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Hide",
  "cross_monitor_move_behaviour": "Insert",
  "mouse_follows_focus": false,
  "default_workspace_padding": 7,
  "default_container_padding": 7,
  "border": true,
  "border_width": 2,
  "border_offset": -1,
  "border_radius": 5,
  "theme":  {
    "palette": "Custom",
      "colours": {
        "base_00": "#0f1417",
        "base_01": "#1c2024", 
        "base_02": "#41484d",
        "base_03": "#41484d",
        "base_04": "#8b9198",
        "base_05": "#c1c7ce",
        "base_06": "#dfe3e7",
        "base_07": "#dfe3e7",
        "base_08": "#ffb4ab",
        "base_09": "#b6c9d8",
        "base_0a": "#ccc1e9",
        "base_0b": "#004c6b",
        "base_0c": "#374955",
        "base_0d": "#91cef5",
        "base_0e": "#4a4263",
        "base_0f": "#93000a"
      },
      "single_border": "Base0D",
      "stack_border":  "Base09",
      "monocle_border": "Base0A",
      "floating_border": "Base0E",
      "unfocused_border":  "Base02",
      "unfocused_locked_border": "Base08",
      "stackbar_focused_text": "Base07",
      "stackbar_unfocused_text": "Base05",
      "stackbar_background": "Base01",
      "bar_accent": "Base0D"
  },
  "animation": {
    "enabled": true,
    "duration": 450,
    "fps": 240,
    "style": {
      "movement" : "EaseOutExpo",
      "transparency" : "Linear"
    }
  },
  "transparency": false,

  "stackbar": {
    "mode": "OnStack",
    "label": "Process"
  },

  "monitors": [
    {
      "workspaces": [
        { "name": "1", "layout": "VerticalStack" },
        { "name": "2", "layout": "VerticalStack" },
        { "name": "3", "layout": "VerticalStack" },
        { "name": "4", "layout": "Grid" },
        { "name": "5", "layout": "Columns" },
        { "name": "6", "layout": "Grid" },
        { "name": "7", "layout": "RightMainVerticalStack" },
        { "name": "8", "layout": "UltrawideVerticalStack" },
        { "name": "9", "layout": "UltrawideVerticalStack" },
        { "name": "10", "layout": "UltrawideVerticalStack" }
      ]
    }
  ],
  "bar_config": "$Env:KOMOREBI_CONFIG_HOME/komorebi.bar.json"
}

